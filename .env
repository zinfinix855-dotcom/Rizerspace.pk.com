# ── Server ─────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# ── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/rizerspace

# ── JWT Authentication ──────────────────────────────────
JWT_SECRET=rizerspace_super_secret_key_change_in_production_1337
JWT_EXPIRE=30d

# ── Cloudinary (Optional - fallback used if missing) ────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Stripe (Optional) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key_here

# ── Currency Exchange API (Optional) ────────────────────
# Free tier: https://api.exchangerate-api.com
EXCHANGE_RATE_API_KEY=your_exchange_rate_key_here
